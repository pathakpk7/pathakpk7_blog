# ================================================================
# THEPATHAK.TECH — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# ================================================================

# ----------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL / Serverless Postgres)
# ----------------------------------------------------------------
# Pooled connection string (used by Next.js app queries & runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct connection string (used for Prisma migrations, db push & seeding)
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth.js v5)
# ----------------------------------------------------------------
# Secret key used to encrypt and sign JWT session tokens (generate with: openssl rand -base64 32 or npx auth secret)
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"

# Canonical URL of your application
AUTH_URL="http://localhost:3000"

# Trust host header on serverless platforms like Vercel
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------------
# 3. OPTIONAL OAUTH PROVIDERS (Social Login)
# ----------------------------------------------------------------
# AUTH_GOOGLE_ID="your-google-oauth-client-id"
# AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# AUTH_GITHUB_ID="your-github-oauth-client-id"
# AUTH_GITHUB_SECRET="your-github-oauth-client-secret"
